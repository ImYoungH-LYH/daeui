#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/dae
LOG_DIR=/var/log/dae
PID_FILE=/var/run/dae.pid

start_service() {
	config_load dae
	local config_file log_maxsize log_maxbackups
	config_get config_file config config_file /etc/dae/config.dae
	config_get log_maxsize config log_maxsize 1
	config_get log_maxbackups config log_maxbackups 1

	if [ ! -s "$config_file" ]; then
		echo "dae: $config_file does not exist yet; configure it in DaeUI first" >&2
		return 1
	fi
	chmod 0600 "$config_file"

	mkdir -p "$LOG_DIR"
	procd_open_instance dae
	procd_set_param command "$PROG" run
	procd_append_param command --config "$config_file"
	procd_append_param command --logfile "$LOG_DIR/dae.log"
	procd_append_param command --logfile-maxsize "$log_maxsize"
	procd_append_param command --logfile-maxbackups "$log_maxbackups"
	procd_set_param limits nofile="1000000 1000000"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

# `dae reload` swaps the datapath in place without dropping established connections.
reload_service() {
	local pid
	pid="$(cat "$PID_FILE" 2>/dev/null)"
	if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
		"$PROG" reload "$pid"
	else
		start
	fi
}

service_triggers() {
	procd_add_reload_trigger dae
}
